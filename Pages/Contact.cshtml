@page
@{
    ViewData["Title"] = "İletişim";
    Layout = "_RevizeLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/contact-premium.css" asp-append-version="true" />
}

<!-- DARK HERO SECTION -->
<section class="contact-dark-hero min-h-[90vh] flex items-center relative">
    <!-- Grid Pattern Overlay -->
    <div class="grid-pattern"></div>
    
    <!-- Floating Orbs -->
    <div class="floating-orb w-[400px] h-[400px] bg-blue-500/30 -top-20 -left-20"></div>
    <div class="floating-orb w-[300px] h-[300px] bg-purple-500/20 bottom-20 right-10" style="animation-delay: -4s;"></div>
    
    <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-5xl">
            <!-- Tag -->
            <div class="mb-8" data-aos="fade-down" data-aos-duration="800">
                <span class="hero-tag-v2">
                    <span class="w-2 h-2 bg-blue-400 rounded-full animate-pulse"></span>
                    Kurumsal İletişim
                </span>
            </div>
            
            <!-- Mega Title -->
            <h1 class="mega-title text-white mb-8" data-aos="fade-up" data-aos-duration="1000">
                BİZİMLE<br/>
                <span class="gradient-text-v2">İLETİŞİME GEÇİN</span>
            </h1>
            
            <!-- Subtitle -->
            <p class="text-xl md:text-2xl text-slate-300 font-light leading-relaxed max-w-2xl mb-12" data-aos="fade-up" data-aos-delay="200">
                Veri odaklı dönüşümünüz için <span class="text-white font-semibold">uzman ekibimiz</span> yanınızda. Projelerinizi birlikte hayata geçirelim.
            </p>
            
            <!-- CTA Buttons -->
            <div class="flex flex-wrap gap-4" data-aos="fade-up" data-aos-delay="400">
                <a href="#contact-form" class="btn-primary-v2">
                    Formu Doldurun
                    <span class="material-symbols-outlined">arrow_downward</span>
                </a>
                <a href="tel:05057195524" class="btn-secondary-v2">
                    <span class="material-symbols-outlined">call</span>
                    0505 719 55 24
                </a>
            </div>
        </div>
    </div>
    
    <!-- Stats Strip at Bottom -->
    <div class="absolute bottom-0 left-0 right-0 stats-strip py-8">
        <div class="container mx-auto px-6">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                <div data-aos="fade-up" data-aos-delay="0">
                    <div class="text-3xl md:text-4xl font-black text-white">2</div>
                    <div class="text-xs text-slate-400 uppercase tracking-wider font-bold">Saat İçinde Yanıt</div>
                </div>
                <div data-aos="fade-up" data-aos-delay="100">
                    <div class="text-3xl md:text-4xl font-black text-white">7/24</div>
                    <div class="text-xs text-slate-400 uppercase tracking-wider font-bold">Teknik Destek</div>
                </div>
                <div data-aos="fade-up" data-aos-delay="200">
                    <div class="text-3xl md:text-4xl font-black text-white">200+</div>
                    <div class="text-xs text-slate-400 uppercase tracking-wider font-bold">Kurumsal Partner</div>
                </div>
                <div data-aos="fade-up" data-aos-delay="300">
                    <div class="text-3xl md:text-4xl font-black text-white">%98</div>
                    <div class="text-xs text-slate-400 uppercase tracking-wider font-bold">Memnuniyet</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CONTACT CHANNELS -->
<section class="py-24 bg-slate-50">
    <div class="container mx-auto px-6">
        <div class="text-center mb-16" data-aos="fade-up">
            <span class="inline-block px-4 py-2 bg-blue-100 text-blue-700 rounded-full text-xs font-bold uppercase tracking-wider mb-4">İletişim Kanalları</span>
            <h2 class="text-4xl md:text-5xl font-black text-slate-900">Size Nasıl Yardımcı Olabiliriz?</h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Sales -->
            <div class="contact-card-v2 p-10" data-aos="fade-up" data-aos-delay="0">
                <div class="card-icon-v2 mb-6">
                    <span class="material-symbols-outlined text-3xl text-blue-600">handshake</span>
                </div>
                <h3 class="text-2xl font-black text-slate-900 mb-3">Satış & İş Birliği</h3>
                <p class="text-slate-500 leading-relaxed mb-6">Yeni projeler, stratejik ortaklıklar ve kurumsal çözümler için bizimle iletişime geçin.</p>
                <a href="mailto:info@bianalytics.com.tr" class="inline-flex items-center gap-2 text-blue-600 font-bold hover:gap-3 transition-all">
                    E-posta Gönder
                    <span class="material-symbols-outlined text-lg">arrow_forward</span>
                </a>
            </div>
            
            <!-- Support -->
            <div class="contact-card-v2 p-10" data-aos="fade-up" data-aos-delay="100">
                <div class="card-icon-v2 mb-6">
                    <span class="material-symbols-outlined text-3xl text-purple-600">support_agent</span>
                </div>
                <h3 class="text-2xl font-black text-slate-900 mb-3">Teknik Destek</h3>
                <p class="text-slate-500 leading-relaxed mb-6">Mevcut sistemleriniz için 7/24 teknik destek hattımız hizmetinizde.</p>
                <a href="tel:05057195524" class="inline-flex items-center gap-2 text-purple-600 font-bold hover:gap-3 transition-all">
                    0505 719 55 24
                    <span class="material-symbols-outlined text-lg">call</span>
                </a>
            </div>
            
            <!-- Press -->
            <div class="contact-card-v2 p-10" data-aos="fade-up" data-aos-delay="200">
                <div class="card-icon-v2 mb-6">
                    <span class="material-symbols-outlined text-3xl text-indigo-600">newspaper</span>
                </div>
                <h3 class="text-2xl font-black text-slate-900 mb-3">Basın & Medya</h3>
                <p class="text-slate-500 leading-relaxed mb-6">Kurumsal haberler, basın bültenleri ve röportaj talepleri için iletişim kurun.</p>
                <a href="mailto:info@bianalytics.com.tr" class="inline-flex items-center gap-2 text-indigo-600 font-bold hover:gap-3 transition-all">
                    Medya Kit
                    <span class="material-symbols-outlined text-lg">download</span>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- FORM & INFO SECTION -->
<section id="contact-form" class="py-24 bg-white">
    <div class="container mx-auto px-6">
        <div class="grid lg:grid-cols-5 gap-8">
            
            <!-- Left: Info Panel (Dark) -->
            <div class="lg:col-span-2" data-aos="fade-right">
                <div class="info-panel-v2 p-10 h-full text-white relative z-10">
                    <h2 class="text-3xl font-black mb-8">Şirket Merkezi</h2>
                    
                    <div class="space-y-8">
                        <!-- Address -->
                        <div class="flex gap-4">
                            <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-blue-400">location_on</span>
                            </div>
                            <div>
                                <div class="text-xs text-slate-400 uppercase tracking-wider font-bold mb-1">Adres</div>
                                <p class="text-white font-medium leading-relaxed">
                                    Gayrettepe Mah. Barbaros Blv. No:143<br/>
                                    34349 Beşiktaş / İstanbul
                                </p>
                            </div>
                        </div>
                        
                        <!-- Phone -->
                        <div class="flex gap-4">
                            <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-purple-400">call</span>
                            </div>
                            <div>
                                <div class="text-xs text-slate-400 uppercase tracking-wider font-bold mb-1">Telefon</div>
                                <a href="tel:05057195524" class="text-white font-bold text-lg hover:text-blue-400 transition-colors">0505 719 55 24</a>
                            </div>
                        </div>
                        
                        <!-- Email -->
                        <div class="flex gap-4">
                            <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-emerald-400">mail</span>
                            </div>
                            <div>
                                <div class="text-xs text-slate-400 uppercase tracking-wider font-bold mb-1">E-posta</div>
                                <a href="mailto:info@bianalytics.com.tr" class="text-white font-bold hover:text-blue-400 transition-colors">info@bianalytics.com.tr</a>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Social -->
                    <div class="mt-12 pt-8 border-t border-white/10">
                        <div class="text-xs text-slate-400 uppercase tracking-wider font-bold mb-4">Sosyal Medya</div>
                        <div class="flex gap-4">
                            <!-- WhatsApp Premium -->
                            <a href="https://wa.me/905057195524" class="social-btn-premium wa-premium" title="WhatsApp">
                                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                            </a>
                            
                            <!-- Telegram Premium -->
                            <a href="https://t.me/bianalytics_info" class="social-btn-premium tg-premium" title="Telegram">
                                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.2-.08-.06-.19-.04-.27-.02-.12.02-1.96 1.25-5.54 3.69-.52.36-1 .53-1.42.52-.47-.01-1.37-.26-2.03-.48-.82-.27-1.47-.42-1.42-.88.03-.24.37-.48 1.02-.73 3.98-1.73 6.64-2.88 7.96-3.45 3.78-1.6 4.57-1.88 5.08-1.89.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.13-.03.2z"/></svg>
                            </a>

                            <!-- LinkedIn -->
                            <a href="#" class="social-btn-premium li-premium" title="LinkedIn">
                                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Right: Form Panel -->
            <div class="lg:col-span-3" data-aos="fade-left">
                <div class="form-panel p-10">
                    <h3 class="text-2xl font-black text-slate-900 mb-2">Bize Mesaj Gönderin</h3>
                    <p class="text-slate-500 mb-8">Formu doldurun, 2 saat içinde size dönüş yapalım.</p>
                    
                    <form id="contactForm" class="space-y-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="label-v2">İsim Soyisim</label>
                                <input type="text" class="input-v2" placeholder="Adınız Soyadınız" required />
                            </div>
                            <div>
                                <label class="label-v2">Telefon</label>
                                <input type="tel" class="input-v2" placeholder="05XX XXX XX XX" required />
                            </div>
                        </div>
                        
                        <div>
                            <label class="label-v2">E-posta</label>
                            <input type="email" class="input-v2" placeholder="email&#64;sirket.com" required />
                        </div>
                        
                        <div>
                            <label class="label-v2">Hizmet Alanı</label>
                            <select class="select-v2">
                                <option>Veri Analitiği & Raporlama</option>
                                <option>Yapay Zeka & ML</option>
                                <option>Cloud Mimarisi</option>
                                <option>ETL & Veri Entegrasyonu</option>
                                <option>Stratejik Danışmanlık</option>
                            </select>
                        </div>
                        
                        <div>
                            <label class="label-v2">Mesajınız</label>
                            <textarea class="textarea-v2" placeholder="Projenizden bahsedin..." required></textarea>
                        </div>
                        
                        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-4">
                            <button type="submit" class="btn-primary-v2">
                                Gönder
                                <span class="material-symbols-outlined">send</span>
                            </button>
                            <span class="text-xs text-slate-400">* KVKK kapsamında verileriniz korunmaktadır.</span>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MAP SECTION -->
<section class="py-16 bg-slate-100">
    <div class="container mx-auto px-6">
        <div class="map-container-v2 h-[400px]">
            <iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3008.963473461245!2d29.011689176587604!3d41.05936717134316!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14cab6524388147d%3A0xc0289b43c490cc6d!2sGayrettepe%20Barbaros%20Bulvar%C4%B1!5e0!3m2!1str!2str!4v1700000000000!5m2!1str!2str" 
                width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
            </iframe>
            
            <div class="map-overlay-badge">
                <span class="material-symbols-outlined text-2xl text-blue-400">location_on</span>
                <div>
                    <div class="text-xs text-slate-400 uppercase tracking-wider font-bold">Merkez Ofis</div>
                    <div class="text-white font-bold">İstanbul, Türkiye</div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize AOS
            AOS.init({
                duration: 800,
                once: true,
                offset: 50
            });

            // Form Submit Handler
            document.getElementById('contactForm').onsubmit = function(e) {
                e.preventDefault();
                
                const btn = this.querySelector('button[type="submit"]');
                const originalHTML = btn.innerHTML;
                
                btn.innerHTML = '<span class="material-symbols-outlined animate-spin">progress_activity</span> Gönderiliyor...';
                btn.disabled = true;
                
                setTimeout(() => {
                    btn.innerHTML = '<span class="material-symbols-outlined">check_circle</span> Gönderildi!';
                    btn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
                    
                    setTimeout(() => {
                        alert('Talebiniz başarıyla iletildi. Uzman ekibimiz 2 saat içinde sizinle iletişime geçecektir.');
                        btn.innerHTML = originalHTML;
                        btn.style.background = '';
                        btn.disabled = false;
                        this.reset();
                    }, 1500);
                }, 1500);
            };
        });
    </script>
}
