@page "/urunler/bianalytics"
@{
    Layout = "_RevizeLayout";
    ViewData["Title"] = "BIAnalytics - Yeni Nesil İş Zekası ve Dashboarding";
}

@* Hero Section *@
<section class="relative w-full overflow-hidden bg-white dark:bg-slate-950 pt-32 pb-24">
    <div class="absolute inset-x-0 top-0 h-96 bg-gradient-to-b from-blue-50 to-transparent dark:from-blue-950/20"></div>
    
    <div class="max-w-7xl mx-auto px-4 relative z-10">
        <div class="max-w-3xl" data-aos="fade-up">
            <span class="text-blue-600 dark:text-blue-400 font-black text-sm uppercase tracking-widest mb-4 block">Görsel Karar Destek</span>
            <h1 class="text-5xl lg:text-7xl font-black text-slate-900 dark:text-white mb-8 leading-tight">Verinizi <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">Hıza Dönüştürün.</span></h1>
            <p class="text-xl text-slate-500 dark:text-slate-400 mb-10 leading-relaxed">
                BIAnalytics ile sektördeki rakiplerinizden <strong>100 kat daha hızlı</strong> filtreleme yapın. Limitsiz CSV dışa aktarım ve 50+ konnektör ile veriniz üzerindeki tüm sınırları kaldırın.
            </p>
            <div class="flex flex-wrap gap-4">
                <a href="http://demo.bianalytics.com.tr/" target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold rounded-2xl hover:scale-105 transition-all">Ücretsiz Deneyin</a>
                <a href="#features" class="px-8 py-4 bg-blue-50 dark:bg-blue-900/10 text-blue-600 dark:text-blue-400 font-bold rounded-2xl hover:bg-blue-100 transition-all">Özellikleri İncele</a>
                <a href="/urunler/bianalytics/releases" class="px-8 py-4 flex items-center gap-2 text-slate-500 dark:text-slate-400 font-bold rounded-2xl hover:text-blue-600 dark:hover:text-blue-400 transition-all border border-transparent hover:border-blue-500/20">
                    <span class="material-symbols-outlined text-xl">history</span>
                    Sürüm Geçmişi
                </a>
            </div>
        </div>

        <div class="mt-20 relative min-h-[600px] flex items-center justify-center pt-8" data-aos="fade-up" data-aos-delay="200">
            @* High-Fidelity Product Display *@
            <div class="relative w-full max-w-7xl mx-auto h-[600px] perspective-[2000px]">
                
                @* 1. The Real Product Image (Direct Display) *@
                <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full lg:w-[95%] h-[550px] bg-white dark:bg-[#0f172a] rounded-2xl border border-slate-200 dark:border-white/10 shadow-[0_50px_100px_rgba(0,0,0,0.2)] overflow-hidden z-20 transform-style-3d rotate-x-[5deg] rotate-z-[-1deg]">
                    <div class="w-full h-full overflow-hidden">
                        <img src="/logo/raporlama_sayfa_resim.png" alt="BIAnalytics Raporlama Arayüzü" class="w-full h-full object-cover object-top" />
                    </div>
                </div>

                @* Subtle Accent Shadow *@
                <div class="absolute inset-0 -z-10 opacity-20 pointer-events-none">
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4/5 h-4/5 bg-blue-500/20 blur-[120px] rounded-full"></div>
                </div>

            </div>
        </div>


        @* Infinite Logo Ribbon (High-Performance Connector Bar) *@
        <div class="mt-8 border-y border-slate-100 dark:border-white/5 bg-slate-50/20 dark:bg-white/2 py-8 overflow-hidden relative">
            <div class="absolute inset-y-0 left-0 w-48 bg-gradient-to-r from-white dark:from-slate-950 to-transparent z-10"></div>
            <div class="absolute inset-y-0 right-0 w-48 bg-gradient-to-l from-white dark:from-slate-950 to-transparent z-10"></div>
            
            <div class="flex items-center gap-20 animate-scroll-normal whitespace-nowrap px-4">
                @foreach (var platform in new[] { "Oracle", "PostgreSQL", "MSSQL", "MySQL", "MongoDB", "BigQuery", "Snowflake", "ClickHouse", "SAP HANA", "Azure", "Excel", "Tableau", "PowerBI", "CSV", "Dynamics 365", "Salesforce" })
                {
                    <div class="flex items-center gap-3 grayscale opacity-30 hover:grayscale-0 hover:opacity-100 transition-all cursor-default group/logo">
                        <div class="p-2.5 rounded-xl bg-white dark:bg-slate-800 shadow-sm border border-slate-200 dark:border-white/10 group-hover/logo:scale-110 group-hover/logo:border-blue-500/50 group-hover/logo:shadow-blue-500/10 transition-all overflow-hidden flex items-center justify-center w-10 h-10">
                            <span class="material-symbols-outlined text-blue-500 text-lg">database</span>
                        </div>
                        <span class="text-xs font-black text-slate-500 dark:text-slate-400 uppercase tracking-tighter">@platform</span>
                    </div>
                }
                @foreach (var platform in new[] { "Oracle", "PostgreSQL", "MSSQL", "MySQL", "MongoDB", "BigQuery", "Snowflake", "ClickHouse", "SAP HANA", "Azure", "Excel", "Tableau", "PowerBI", "CSV", "Dynamics 365", "Salesforce" })
                {
                    <div class="flex items-center gap-3 grayscale opacity-30 hover:grayscale-0 hover:opacity-100 transition-all cursor-default group/logo">
                        <div class="p-2.5 rounded-xl bg-white dark:bg-slate-800 shadow-sm border border-slate-200 dark:border-white/10 group-hover/logo:scale-110 group-hover/logo:border-blue-500/50 group-hover/logo:shadow-blue-500/10 transition-all overflow-hidden flex items-center justify-center w-10 h-10">
                            <span class="material-symbols-outlined text-blue-500 text-lg">database</span>
                        </div>
                        <span class="text-xs font-black text-slate-500 dark:text-slate-400 uppercase tracking-tighter">@platform</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>


<style>
    .transform-style-3d { transform-style: preserve-3d; }
    
    @@keyframes float-slow {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-20px); }
    }
    
    @@keyframes float-delayed {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-15px); }
    }
    
    @@keyframes scroll-normal {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    
    @@keyframes dash {
        0% { stroke-dasharray: 0, 1000; stroke-dashoffset: 0; }
        100% { stroke-dasharray: 1000, 1000; stroke-dashoffset: -1000; }
    }
    
    @@keyframes pulse-height {
        0%, 100% { height: 20%; opacity: 0.6; }
        50% { height: 100%; opacity: 1; }
    }
    
    .animate-float-slow { animation: float-slow 6s ease-in-out infinite; }
    .animate-float-delayed { animation: float-delayed 7s ease-in-out infinite; animation-delay: 1.5s; }
    .animate-scroll-normal { animation: scroll-normal 40s linear infinite; }
    .animate-dash { animation: dash 4s linear infinite; }
    .animate-pulse-height { animation: pulse-height 1.2s ease-in-out infinite; }
    
    .anim-fill { animation: fill-bar 3s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @@keyframes fill-bar {
        from { width: 0; }
    }
</style>

@* Features Section *@
<section id="features" class="py-24 bg-slate-50 dark:bg-slate-900/50">
    <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-16" data-aos="fade-up">
            <h2 class="text-3xl lg:text-5xl font-bold text-slate-900 dark:text-white mb-4">Özellikler</h2>
            <p class="text-slate-500 dark:text-slate-400 max-w-2xl mx-auto">BIAnalytics ile verilerinizi görselleştirin, analiz edin ve raporlayın.</p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            @* Card 1: Gelişmiş Dashboard Export *@
            <div class="relative group">
                <!-- Main Card -->
                <div onclick="document.getElementById('modal-export').classList.remove('opacity-0', 'invisible'); document.getElementById('modal-export').classList.add('opacity-100', 'visible');" class="h-full bg-white dark:bg-slate-900 p-8 rounded-[2rem] border border-slate-200 dark:border-slate-800 hover:border-blue-500/50 hover:shadow-2xl transition-all duration-300 flex flex-col items-start cursor-pointer hover:bg-blue-50/50 dark:hover:bg-blue-900/10">
                    <span class="material-symbols-outlined text-3xl text-blue-500 mb-4 bg-gradient-to-br from-blue-500/20 to-blue-500/5 w-14 h-14 flex items-center justify-center rounded-2xl group-hover:scale-110 transition-transform duration-300">file_download</span>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3">Gelişmiş Dashboard Export</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Dashboard içerisinde yer alan tüm raporlar tek bir Excel dosyası olarak indirilebilir. Chart'ları tek tek veya seçerek export alma esnekliği.</p>
                    
                    <div class="mt-auto pt-6 flex items-center gap-2 text-blue-600 dark:text-blue-400 text-[10px] font-black uppercase tracking-widest border-t border-slate-100 dark:border-slate-800 w-full">
                        <span class="relative flex h-2 w-2">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
                        </span>
                        İzlemek İçin Tıklayın
                    </div>
                </div>

                @* Modal *@
                <div id="modal-export" class="fixed inset-0 opacity-0 invisible transition-all duration-500 ease-in-out z-[9999] flex items-center justify-center p-4 md:p-12">
                    <div class="absolute inset-0 bg-slate-950/90 backdrop-blur-2xl" onclick="document.getElementById('modal-export').classList.add('opacity-0', 'invisible'); document.getElementById('modal-export').classList.remove('opacity-100', 'visible');"></div>
                    <div class="relative w-full max-w-7xl aspect-video bg-black rounded-[3rem] p-2 md:p-4 shadow-[0_0_100px_rgba(59,130,246,0.3)] border border-white/10 overflow-hidden transform scale-95 transition-transform duration-500">
                        <div class="absolute top-8 left-10 z-20 hidden md:block">
                            <h4 class="text-2xl font-black text-white/90 mb-1 flex items-center gap-3">
                                <span class="w-2 h-8 bg-blue-500 rounded-full"></span>
                                Gelişmiş Dashboard Export - Canlı Canlı İzleyin
                            </h4>
                            <p class="text-white/40 text-sm">BIAnalytics Export Motoru v4.0.2 - Video Preview</p>
                        </div>
                        <button onclick="document.getElementById('modal-export').classList.add('opacity-0', 'invisible'); document.getElementById('modal-export').classList.remove('opacity-100', 'visible');" class="absolute top-8 right-10 z-30 p-2 bg-white/10 backdrop-blur-md rounded-full text-white hover:bg-white/20 transition-all border border-white/5">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                        <div class="w-full h-full rounded-[2rem] overflow-hidden bg-slate-900/50 flex items-center justify-center border border-white/10">
                            <video class="w-full h-full object-contain" autoplay loop muted playsinline>
                                <source src="/videos/gelişmiş-export.mp4" type="video/mp4">
                            </video>
                        </div>
                    </div>
                </div>
            </div>

            @* Card 2: Sürükle-Bırak Dashboard Tasarımı *@
            <div class="relative group">
                <!-- Main Card -->
                <div onclick="document.getElementById('modal-drag-drop').classList.remove('opacity-0', 'invisible'); document.getElementById('modal-drag-drop').classList.add('opacity-100', 'visible');" class="h-full bg-white dark:bg-slate-900 p-8 rounded-[2rem] border border-slate-200 dark:border-slate-800 hover:border-indigo-500/50 hover:shadow-2xl transition-all duration-300 flex flex-col items-start cursor-pointer hover:bg-indigo-50/50 dark:hover:bg-indigo-900/10">
                    <span class="material-symbols-outlined text-3xl text-indigo-500 mb-4 bg-gradient-to-br from-indigo-500/20 to-indigo-500/5 w-14 h-14 flex items-center justify-center rounded-2xl group-hover:scale-110 transition-transform duration-300">dashboard_customize</span>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3">Sürükle-Bırak Dashboard Tasarımı</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Teknik bilgiye ihtiyaç duymadan görsel bileşen kütüphanesinden seçim yaparak saniyeler içinde kişisel raporlar ve dashboard'lar tasarlayın.</p>
                    
                    <div class="mt-auto pt-6 flex items-center gap-2 text-indigo-600 dark:text-indigo-400 text-[10px] font-black uppercase tracking-widest border-t border-slate-100 dark:border-slate-800 w-full">
                        <span class="relative flex h-2 w-2">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
                        </span>
                        İzlemek İçin Tıklayın
                    </div>
                </div>

                @* Modal *@
                <div id="modal-drag-drop" class="fixed inset-0 opacity-0 invisible transition-all duration-500 ease-in-out z-[9999] flex items-center justify-center p-4 md:p-12">
                    <div class="absolute inset-0 bg-slate-950/90 backdrop-blur-2xl" onclick="document.getElementById('modal-drag-drop').classList.add('opacity-0', 'invisible'); document.getElementById('modal-drag-drop').classList.remove('opacity-100', 'visible');"></div>
                    <div class="relative w-full max-w-7xl aspect-video bg-black rounded-[3rem] p-2 md:p-4 shadow-[0_0_100px_rgba(79,70,229,0.3)] border border-white/10 overflow-hidden transform scale-95 transition-transform duration-500">
                        <div class="absolute top-8 left-10 z-20 hidden md:block">
                            <h4 class="text-2xl font-black text-white/90 mb-1 flex items-center gap-3">
                                <span class="w-2 h-8 bg-indigo-500 rounded-full"></span>
                                Sürükle-Bırak Dashboard Tasarımı - Kayıt
                            </h4>
                            <p class="text-white/40 text-sm">BIAnalytics Tasarım Modülü v4.0.2 - HD Preview</p>
                        </div>
                        <button onclick="document.getElementById('modal-drag-drop').classList.add('opacity-0', 'invisible'); document.getElementById('modal-drag-drop').classList.remove('opacity-100', 'visible');" class="absolute top-8 right-10 z-30 p-2 bg-white/10 backdrop-blur-md rounded-full text-white hover:bg-white/20 transition-all border border-white/5">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                        <div class="w-full h-full rounded-[2rem] overflow-hidden bg-slate-900/50 flex items-center justify-center border border-white/10">
                            <video class="w-full h-full object-contain" autoplay loop muted playsinline>
                                <source src="/videos/sürükle-bırak-dashboard.mp4" type="video/mp4">
                            </video>
                        </div>
                    </div>
                </div>
            </div>

            @* Card 3: Evrensel Veri Konnektörleri *@
            <div class="bg-white dark:bg-slate-900 p-8 rounded-[2rem] border border-slate-200 dark:border-slate-800 hover:border-rose-500/50 hover:shadow-xl hover:shadow-rose-500/10 transition-all duration-300 group">
                <span class="material-symbols-outlined text-3xl text-rose-500 mb-4 bg-gradient-to-br from-rose-500/20 to-rose-500/5 w-14 h-14 flex items-center justify-center rounded-2xl group-hover:scale-110 transition-transform duration-300">hub</span>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3">Evrensel Veri Konnektörleri</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400">MSSQL, Oracle, PostgreSQL, MySQL ve daha fazlası. Tüm veritabanlarına tek tıkla bağlanın ve verilerinizi anında görselleştirin.</p>
            </div>

            @* Card 4: Alerts & Zamanlanmış Raporlama *@
            <div class="relative group">
                <!-- Main Card -->
                <div onclick="document.getElementById('modal-alerts').classList.remove('opacity-0', 'invisible'); document.getElementById('modal-alerts').classList.add('opacity-100', 'visible');" class="h-full bg-white dark:bg-slate-900 p-8 rounded-[2rem] border border-slate-200 dark:border-slate-800 hover:border-amber-500/50 hover:shadow-2xl transition-all duration-300 flex flex-col items-start cursor-pointer hover:bg-amber-50/50 dark:hover:bg-amber-900/10">
                    <span class="material-symbols-outlined text-3xl text-amber-500 mb-4 bg-gradient-to-br from-amber-500/20 to-amber-500/5 w-14 h-14 flex items-center justify-center rounded-2xl group-hover:scale-110 transition-transform duration-300">notifications_active</span>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3">Alerts & Zamanlanmış Raporlama</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Kurumsal raporlama ihtiyaçlarının temel bileşenlerinden biri olan zamanlanmış raporlar, PDF export ve otomatik e-posta gönderimi.</p>
                    
                    <div class="mt-auto pt-6 flex items-center gap-2 text-amber-600 dark:text-amber-400 text-[10px] font-black uppercase tracking-widest border-t border-slate-100 dark:border-slate-800 w-full">
                        <span class="relative flex h-2 w-2">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
                        </span>
                        İzlemek İçin Tıklayın
                    </div>
                </div>

                @* Modal *@
                <div id="modal-alerts" class="fixed inset-0 opacity-0 invisible transition-all duration-500 ease-in-out z-[9999] flex items-center justify-center p-4 md:p-12">
                    <div class="absolute inset-0 bg-slate-950/90 backdrop-blur-2xl" onclick="document.getElementById('modal-alerts').classList.add('opacity-0', 'invisible'); document.getElementById('modal-alerts').classList.remove('opacity-100', 'visible');"></div>
                    <div class="relative w-full max-w-7xl aspect-video bg-black rounded-[3rem] p-2 md:p-4 shadow-[0_0_100px_rgba(245,158,11,0.3)] border border-white/10 overflow-hidden transform scale-95 transition-transform duration-500">
                        <div class="absolute top-8 left-10 z-20 hidden md:block">
                            <h4 class="text-2xl font-black text-white/90 mb-1 flex items-center gap-3">
                                <span class="w-2 h-8 bg-amber-500 rounded-full"></span>
                                Alerts & Zamanlanmış Raporlama
                            </h4>
                            <p class="text-white/40 text-sm">BIAnalytics Automation v4.0.2 - System Preview</p>
                        </div>
                        <button onclick="document.getElementById('modal-alerts').classList.add('opacity-0', 'invisible'); document.getElementById('modal-alerts').classList.remove('opacity-100', 'visible');" class="absolute top-8 right-10 z-30 p-2 bg-white/10 backdrop-blur-md rounded-full text-white hover:bg-white/20 transition-all border border-white/5">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                        <div class="w-full h-full rounded-[2rem] overflow-hidden bg-slate-900/50 flex items-center justify-center border border-white/10">
                            <video class="w-full h-full object-contain" autoplay loop muted playsinline>
                                <source src="/videos/Alerts & Zamanlanmış Raporlama.mp4" type="video/mp4">
                            </video>
                        </div>
                    </div>
                </div>
            </div>

            @* Card 5: Full Data CSV Export *@
            <div class="relative group">
                <!-- Main Card -->
                <div onclick="document.getElementById('modal-csv').classList.remove('opacity-0', 'invisible'); document.getElementById('modal-csv').classList.add('opacity-100', 'visible');" class="h-full bg-white dark:bg-slate-900 p-8 rounded-[2rem] border border-slate-200 dark:border-slate-800 hover:border-emerald-500/50 hover:shadow-2xl transition-all duration-300 flex flex-col items-start cursor-pointer hover:bg-emerald-50/50 dark:hover:bg-emerald-900/10">
                    <span class="material-symbols-outlined text-3xl text-emerald-500 mb-4 bg-gradient-to-br from-emerald-500/20 to-emerald-500/5 w-14 h-14 flex items-center justify-center rounded-2xl group-hover:scale-110 transition-transform duration-300">csv</span>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3">Full Data CSV Export</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Chart üzerinde gösterilmeyen ancak dataset içerisinde tanımlı olan tüm alanlar, eksiksiz şekilde CSV formatında export edilebilir.</p>
                    
                    <div class="mt-auto pt-6 flex items-center gap-2 text-emerald-600 dark:text-emerald-400 text-[10px] font-black uppercase tracking-widest border-t border-slate-100 dark:border-slate-800 w-full">
                        <span class="relative flex h-2 w-2">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                        </span>
                        İzlemek İçin Tıklayın
                    </div>
                </div>

                @* Modal *@
                <div id="modal-csv" class="fixed inset-0 opacity-0 invisible transition-all duration-500 ease-in-out z-[9999] flex items-center justify-center p-4 md:p-12">
                    <div class="absolute inset-0 bg-slate-950/90 backdrop-blur-2xl" onclick="document.getElementById('modal-csv').classList.add('opacity-0', 'invisible'); document.getElementById('modal-csv').classList.remove('opacity-100', 'visible');"></div>
                    <div class="relative w-full max-w-7xl aspect-video bg-black rounded-[3rem] p-2 md:p-4 shadow-[0_0_100px_rgba(16,185,129,0.3)] border border-white/10 overflow-hidden transform scale-95 transition-transform duration-500">
                        <div class="absolute top-8 left-10 z-20 hidden md:block">
                            <h4 class="text-2xl font-black text-white/90 mb-1 flex items-center gap-3">
                                <span class="w-2 h-8 bg-emerald-500 rounded-full"></span>
                                Full Data CSV Export - Veri Aktarımı
                            </h4>
                            <p class="text-white/40 text-sm">BIAnalytics Export Engine v4.0.2 - Data Preview</p>
                        </div>
                        <button onclick="document.getElementById('modal-csv').classList.add('opacity-0', 'invisible'); document.getElementById('modal-csv').classList.remove('opacity-100', 'visible');" class="absolute top-8 right-10 z-30 p-2 bg-white/10 backdrop-blur-md rounded-full text-white hover:bg-white/20 transition-all border border-white/5">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                        <div class="w-full h-full rounded-[2rem] overflow-hidden bg-slate-900/50 flex items-center justify-center border border-white/10">
                            <video class="w-full h-full object-contain" autoplay loop muted playsinline>
                                <source src="/videos/full-data-export.mp4" type="video/mp4">
                            </video>
                        </div>
                    </div>
                </div>
            </div>

            @* Card 6: LDAP Authentication & RBAC *@
            <div class="bg-white dark:bg-slate-900 p-8 rounded-[2rem] border border-slate-200 dark:border-slate-800 hover:border-purple-500/50 hover:shadow-xl hover:shadow-purple-500/10 transition-all duration-300 group">
                <span class="material-symbols-outlined text-3xl text-purple-500 mb-4 bg-gradient-to-br from-purple-500/20 to-purple-500/5 w-14 h-14 flex items-center justify-center rounded-2xl group-hover:scale-110 transition-transform duration-300">admin_panel_settings</span>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3">LDAP Authentication & RBAC</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400">Active Directory entegrasyonu ile merkezi kullanıcı yönetimi. Rol bazlı yetkilendirme ile veri güvenliğini en üst düzeyde tutun.</p>
            </div>

            @* Card 7: Redis Cache & Pagination *@
